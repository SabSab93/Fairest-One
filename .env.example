# Adresse HTTP du service qui tournera sur la Raspberry Pi.
API_BASE_URL=http://raspberrypi.local:8080/

# Canal temps réel pour les événements du miroir.
WS_BASE_URL=ws://raspberrypi.local:8080/ws

# Identifiant stable du miroir installé chez l'opticien.
MIRROR_DEVICE_ID=fairest-one-mirror-01

# true tant que la Raspberry Pi et l'Arduino ne sont pas disponibles.
USE_MOCK_IOT=true

# Délai maximal d'une requête vers la Raspberry Pi.
REQUEST_TIMEOUT_SECONDS=10

# SHA-256 du code administrateur du prototype (1234).
# Ne constitue pas une protection suffisante pour la production.
ADMIN_PIN_HASH=03ac674216f3e15c761ee1a5e255f067953623c8b388b4459e13f978d7c846f4

# Projet Supabase. La clé publishable est publique, jamais la clé service_role.
SUPABASE_URL=https://olktukdervvumtjkjuub.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Garder false jusqu'à l'installation du schéma et des règles RLS.
USE_SUPABASE=false
